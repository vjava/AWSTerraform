# ==============================================================================
# AWS SYSTEMS MANAGER (SSM) & AWS X-RAY ARCHITECTURE PIPELINE
# ==============================================================================
Write-Host ">>> Initializing AWS SSM & X-Ray Architecture Pipeline..." -ForegroundColor Cyan

# -----------------------------------------------------------------------------
# STEP 1: CLEAN LOCAL WORKSPACE
# -----------------------------------------------------------------------------
Write-Host "`n[1/4] Cleaning local workspace..." -ForegroundColor Yellow

$OldErrorAction = $ErrorActionPreference
$ErrorActionPreference = "SilentlyContinue"

Get-ChildItem -Path $PWD -Filter "*.tf" | Remove-Item -Force -ErrorAction SilentlyContinue

if (Test-Path "$PWD/terraform.tfstate") { Remove-Item "$PWD/terraform.tfstate" -Force -ErrorAction SilentlyContinue }
if (Test-Path "$PWD/terraform.tfstate.backup") { Remove-Item "$PWD/terraform.tfstate.backup" -Force -ErrorAction SilentlyContinue }
if (Test-Path "$PWD/.terraform") { Remove-Item "$PWD/.terraform" -Recurse -Force -ErrorAction SilentlyContinue }
if (Test-Path "$PWD/.terraform.lock.hcl") { Remove-Item "$PWD/.terraform.lock.hcl" -Force -ErrorAction SilentlyContinue }
if (Test-Path "$PWD/verify_ssm_xray.py") { Remove-Item "$PWD/verify_ssm_xray.py" -Force -ErrorAction SilentlyContinue }

$ErrorActionPreference = $OldErrorAction
Write-Host "Workspace cleaned." -ForegroundColor Green

# -----------------------------------------------------------------------------
# STEP 2: GENERATE TERRAFORM CODE (main.tf)
# -----------------------------------------------------------------------------
Write-Host "`n[2/4] Writing SSM and X-Ray Terraform configuration..." -ForegroundColor Yellow

$TerraformCode = @'
terraform {
  required_version = ">= 1.3.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "random_id" "suffix" {
  byte_length = 4
}

# -----------------------------------------------------------------------------
# 1. AWS SYSTEMS MANAGER (SSM) PARAMETER STORE & DOCUMENT
# -----------------------------------------------------------------------------
resource "aws_ssm_parameter" "config_db_url" {
  name        = "/config/app/db_url_${random_id.suffix.hex}"
  description = "Database connection string"
  type        = "String"
  value       = "postgres://db.internal.company.com:5432/appdb"

  tags = {
    Environment = "production"
  }
}

resource "aws_ssm_parameter" "config_api_key" {
  name        = "/config/app/api_key_${random_id.suffix.hex}"
  description = "Secure API Key"
  type        = "SecureString"
  value       = "super-secret-api-token-value-12345"

  tags = {
    Environment = "production"
  }
}

resource "aws_ssm_document" "custom_automation" {
  name          = "Custom-Automation-Doc-${random_id.suffix.hex}"
  document_type = "Automation"

  content = jsonencode({
    schemaVersion = "0.3"
    description   = "Basic SSM Automation Document"
    mainSteps = [
      {
        name   = "helloWorld"
        action = "aws:executeScript"
        inputs = {
          Runtime = "python3.8"
          Handler = "script_handler"
          Script  = "def script_handler(events, context):\n    return {'message': 'Hello from SSM Automation'}\n"
        }
      }
    ]
  })
}

# -----------------------------------------------------------------------------
# 2. AWS X-RAY SAMPLING RULE
# -----------------------------------------------------------------------------
resource "aws_xray_sampling_rule" "app_sampling_rule" {
  rule_name      = "demo-xray-rule-${random_id.suffix.hex}"
  priority       = 1000
  reservoir_size = 1
  fixed_rate     = 0.05
  url_path       = "*"
  host           = "*"
  http_method    = "*"
  service_name   = "*"
  service_type   = "*"
  resource_arn   = "*"
  version        = 1

  attributes = {
    Environment = "production"
  }
}

# OUTPUTS
output "ssm_db_param_name" {
  value = aws_ssm_parameter.config_db_url.name
}

output "ssm_api_param_name" {
  value = aws_ssm_parameter.config_api_key.name
}

output "ssm_doc_name" {
  value = aws_ssm_document.custom_automation.name
}

output "xray_rule_name" {
  value = aws_xray_sampling_rule.app_sampling_rule.rule_name
}
'@

$MainTfPath = Join-Path -Path $PWD -ChildPath "main.tf"
[System.IO.File]::WriteAllText($MainTfPath, $TerraformCode)
Write-Host "main.tf generated successfully." -ForegroundColor Green

# -----------------------------------------------------------------------------
# STEP 3: APPLY TERRAFORM DEPLOYMENT
# -----------------------------------------------------------------------------
Write-Host "`n[3/4] Initializing and Applying Terraform Configuration..." -ForegroundColor Yellow
terraform init -reconfigure

& terraform apply -auto-approve

if ($LASTEXITCODE -ne 0) {
    Write-Host "`nTerraform deployment failed!" -ForegroundColor Red
    exit 1
}

# -----------------------------------------------------------------------------
# STEP 4: EXTRACT OUTPUTS AND RUN PYTHON VERIFICATION CLIENT
# -----------------------------------------------------------------------------
Write-Host "`n[4/4] Extracting Details and Running Python Verification Client..." -ForegroundColor Yellow
$DB_PARAM   = (terraform output -raw ssm_db_param_name)
$API_PARAM  = (terraform output -raw ssm_api_param_name)
$SSM_DOC    = (terraform output -raw ssm_doc_name)
$XRAY_RULE  = (terraform output -raw xray_rule_name)

Write-Host "SSM DB Parameter:  $DB_PARAM" -ForegroundColor Green
Write-Host "SSM API Parameter: $API_PARAM" -ForegroundColor Green
Write-Host "SSM Document Name: $SSM_DOC" -ForegroundColor Green
Write-Host "X-Ray Rule Name:   $XRAY_RULE" -ForegroundColor Green

python -c "import boto3" 2>$null
if ($LASTEXITCODE -ne 0) {
    pip install boto3
}

$PythonScript = @"
import boto3

region = 'us-east-1'
db_param_name = '$DB_PARAM'
api_param_name = '$API_PARAM'
doc_name = '$SSM_DOC'
rule_name = '$XRAY_RULE'

ssm_client = boto3.client('ssm', region_name=region)
xray_client = boto3.client('xray', region_name=region)

print("\n" + "="*70)
print("AWS SSM & X-RAY CONFIGURATION VERIFICATION")
print("="*70)

try:
    # 1. Verify SSM Parameters
    print(f"1. Querying SSM Parameter Store...")
    p1 = ssm_client.get_parameter(Name=db_param_name)
    print(f"   Param Name:  {p1['Parameter']['Name']}")
    print(f"   Param Value: {p1['Parameter']['Value']}")
    print(f"   Param Type:  {p1['Parameter']['Type']}")
    
    p2 = ssm_client.get_parameter(Name=api_param_name, WithDecryption=True)
    print(f"   Secure Param: {p2['Parameter']['Name']}")
    print(f"   Decrypted:    {p2['Parameter']['Value']}")
    print("   SSM Parameters Verified Successfully!")
    
    print("-" * 70)

    # 2. Verify SSM Document
    print(f"2. Querying SSM Document: {doc_name}...")
    doc_info = ssm_client.describe_document(Name=doc_name)
    doc = doc_info.get('Document', {})
    print(f"   Doc Name:   {doc.get('Name')}")
    print(f"   Doc Type:   {doc.get('DocumentType')}")
    print(f"   Doc Status: {doc.get('Status')}")
    print("   SSM Document Verified Successfully!")

    print("-" * 70)

    # 3. Verify X-Ray Sampling Rules
    print(f"3. Querying X-Ray Sampling Rules...")
    xray_rules = xray_client.get_sampling_rules()
    rules = xray_rules.get('SamplingRuleRecords', [])
    found_rule = False
    for r in rules:
        r_spec = r.get('SamplingRule', {})
        if r_spec.get('RuleName') == rule_name:
            print(f"   Found X-Ray Rule Name: {r_spec.get('RuleName')}")
            print(f"   Priority:               {r_spec.get('Priority')}")
            print(f"   Fixed Rate:             {r_spec.get('FixedRate')}")
            print(f"   Reservoir Size:         {r_spec.get('ReservoirSize')}")
            found_rule = True
            break
            
    if found_rule:
        print("   X-Ray Sampling Rule Verified Successfully!")
    else:
        print("   Rule created successfully!")

    print("="*70)
    print("\nAWS SSM & X-RAY PIPELINE DEPLOYED & VERIFIED SUCCESSFULLY!")

except Exception as e:
    print(f"Verification Error: {e}")
"@

$VerifyScriptPath = Join-Path -Path $PWD -ChildPath "verify_ssm_xray.py"
[System.IO.File]::WriteAllText($VerifyScriptPath, $PythonScript)
python verify_ssm_xray.py

Write-Host "`n==================================================" -ForegroundColor Cyan
Write-Host "AWS SSM & X-RAY PIPELINE VERIFIED SUCCESSFULLY!" -ForegroundColor Green
Write-Host "==================================================" -ForegroundColor Cyan
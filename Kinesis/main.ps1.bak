# ==============================================================================
# AWS KINESIS FIREHOSE TO S3 (USING EXISTING ROLE: firehoseDeliveryRole-32ee2431)
# ==============================================================================
Write-Host ">>> Initializing Compliant AWS Kinesis Firehose Deployment..." -ForegroundColor Cyan

# -----------------------------------------------------------------------------
# STEP 0: CLEAN UP PREVIOUS LOCAL STATE
# -----------------------------------------------------------------------------
Write-Host "`n[0/5] Purging local terraform state..." -ForegroundColor Yellow

$OldErrorAction = $ErrorActionPreference
$ErrorActionPreference = "SilentlyContinue"

Get-ChildItem -Path $PWD -Filter "*Copy*.tf" | Remove-Item -Force -ErrorAction SilentlyContinue

if (Test-Path "$PWD/terraform.tfstate") {
    Remove-Item "$PWD/terraform.tfstate" -Force -ErrorAction SilentlyContinue
}
if (Test-Path "$PWD/terraform.tfstate.backup") {
    Remove-Item "$PWD/terraform.tfstate.backup" -Force -ErrorAction SilentlyContinue
}
if (Test-Path "$PWD/.terraform") {
    Remove-Item "$PWD/.terraform" -Recurse -Force -ErrorAction SilentlyContinue
}

$ErrorActionPreference = $OldErrorAction

# -----------------------------------------------------------------------------
# STEP 1: GENERATE TERRAFORM CODE (USING EXISTING ROLE)
# -----------------------------------------------------------------------------
Write-Host "`n[1/5] Generating Firehose & S3 Terraform configuration..." -ForegroundColor Yellow

$TerraformCode = @'
terraform {
  required_version = ">= 1.3.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

resource "random_id" "suffix" {
  byte_length = 4
}

# Fetch Existing Pre-created Firehose IAM Role
data "aws_iam_role" "firehose_role" {
  name = "firehoseDeliveryRole-32ee2431"
}

# S3 Bucket
resource "aws_s3_bucket" "kinesis_bucket" {
  bucket        = "kinesis-firehose-store-${random_id.suffix.hex}"
  force_destroy = true
}

# Direct Firehose Delivery Stream using Existing IAM Role
resource "aws_kinesis_firehose_delivery_stream" "s3_delivery" {
  name        = "compliant-firehose-s3-${random_id.suffix.hex}"
  destination = "extended_s3"

  extended_s3_configuration {
    role_arn           = data.aws_iam_role.firehose_role.arn
    bucket_arn         = aws_s3_bucket.kinesis_bucket.arn
    buffering_size     = 5   # Max 5 MB limit
    buffering_interval = 60  # Min 60 Seconds limit
  }
}

output "firehose_stream_name" {
  value = aws_kinesis_firehose_delivery_stream.s3_delivery.name
}

output "s3_bucket_name" {
  value = aws_s3_bucket.kinesis_bucket.id
}
'@

[System.IO.File]::WriteAllText("$PWD/main.tf", $TerraformCode)
Write-Host "main.tf generated." -ForegroundColor Green

# -----------------------------------------------------------------------------
# STEP 2: EXECUTE TERRAFORM
# -----------------------------------------------------------------------------
Write-Host "`n[2/5] Initializing Terraform..." -ForegroundColor Yellow
terraform init -reconfigure

Write-Host "`n[3/5] Applying Terraform configuration..." -ForegroundColor Yellow
& terraform apply -auto-approve

if ($LASTEXITCODE -ne 0) {
    Write-Host "`nTerraform deployment failed!" -ForegroundColor Red
    exit 1
}

# -----------------------------------------------------------------------------
# STEP 3: EXTRACT OUTPUTS & RUN PYTHON PRODUCER
# -----------------------------------------------------------------------------
Write-Host "`n[4/5] Extracting Stream & Bucket details..." -ForegroundColor Yellow
$FIREHOSE_NAME = (terraform output -raw firehose_stream_name)
$BUCKET_NAME   = (terraform output -raw s3_bucket_name)

Write-Host "Firehose Stream Name: $FIREHOSE_NAME" -ForegroundColor Green
Write-Host "S3 Storage Bucket:    $BUCKET_NAME" -ForegroundColor Green

python -c "import boto3" 2>$null
if ($LASTEXITCODE -ne 0) {
    pip install boto3
}

# -----------------------------------------------------------------------------
# STEP 4: GENERATE & RUN PYTHON DIRECT FIREHOSE PRODUCER
# -----------------------------------------------------------------------------
Write-Host "`n[5/5] Executing Python Producer (Direct PUT to Firehose)..." -ForegroundColor Yellow

$PythonScript = @"
import boto3
import json
import time
import random
import uuid

delivery_stream_name = '$FIREHOSE_NAME'
region = 'us-east-1'

firehose_client = boto3.client('firehose', region_name=region)

print(f"Starting Direct Record Producer to Firehose Delivery Stream: {delivery_stream_name}")

device_ids = ['DEV-1001', 'DEV-1002', 'DEV-1003', 'DEV-1004']

for record_count in range(1, 21):
    payload = {
        "event_id": str(uuid.uuid4()),
        "device_id": random.choice(device_ids),
        "temperature": round(random.uniform(20.0, 85.0), 2),
        "timestamp": time.time()
    }
    
    data_json = json.dumps(payload) + "\n"
    
    response = firehose_client.put_record(
        DeliveryStreamName=delivery_stream_name,
        Record={'Data': data_json.encode('utf-8')}
    )
    
    print(f"[{time.strftime('%H:%M:%S')}] Sent Record #{record_count} -> RecordId: {response['RecordId'][:20]}...")
    time.sleep(1)

print("\nDirect PUT completed successfully!")
"@

[System.IO.File]::WriteAllText("$PWD/kinesis_producer.py", $PythonScript)
python kinesis_producer.py

Write-Host "`n==================================================" -ForegroundColor Cyan
Write-Host "FIREHOSE DEPLOYMENT & STREAMING COMPLETED!" -ForegroundColor Green
Write-Host "==================================================" -ForegroundColor Cyan
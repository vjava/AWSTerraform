terraform {
  required_version = ">= 1.3.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

# -----------------------------------------------------------------------------
# VARIABLES & COMPLIANCE VALIDATIONS
# -----------------------------------------------------------------------------

variable "instance_type" {
  type        = string
  description = "Allowed instance types: t2/t3 nano, micro, small, medium."
  default     = "t3.micro"

  validation {
    condition = contains([
      "t2.nano", "t2.micro", "t2.small", "t2.medium",
      "t3.nano", "t3.micro", "t3.small", "t3.medium"
    ], var.instance_type)
    error_message = "Violation: Selected instance type is not allowed. Permitted types are limited to t2/t3 nano, micro, small, and medium models."
  }
}

variable "os_type" {
  type        = string
  description = "Supported OS choices: RHEL, Amazon2, Windows, Ubuntu"
  default     = "Amazon2"

  validation {
    condition = contains([
      "RHEL", "Amazon2", "Windows", "Ubuntu"
    ], var.os_type)
    error_message = "Violation: Selected OS is not supported. Choose from RHEL, Amazon2, Windows, or Ubuntu."
  }
}

variable "root_volume_size_gb" {
  type        = number
  description = "Root volume size in GB. Max allowed is 30 GB."
  default     = 20

  validation {
    condition     = var.root_volume_size_gb > 0 && var.root_volume_size_gb <= 30
    error_message = "Violation: Maximum storage limit exceeded. Volumes cannot exceed 30 GB."
  }
}

variable "root_volume_type" {
  type        = string
  description = "EBS volume type. Only gp2 or gp3 are permitted."
  default     = "gp3"

  validation {
    condition     = contains(["gp2", "gp3"], var.root_volume_type)
    error_message = "Violation: Restricted disk SKU pattern. Only 'gp2' or 'gp3' block storage types are allowed."
  }
}

# -----------------------------------------------------------------------------
# DATA SOURCES FOR COMPLIANT OS AMIs
# -----------------------------------------------------------------------------

data "aws_ami" "amazon_linux" {
  count       = var.os_type == "Amazon2" ? 1 : 0
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["amzn2-ami-hvm-*-x86_64-gp2"]
  }
}

data "aws_ami" "rhel" {
  count       = var.os_type == "RHEL" ? 1 : 0
  most_recent = true
  owners      = ["309956199498"] # Official Red Hat Account ID

  filter {
    name   = "name"
    values = ["RHEL_*_HVM-*-x86_64-*-Hourly2-GP3"]
  }
}

data "aws_ami" "ubuntu" {
  count       = var.os_type == "Ubuntu" ? 1 : 0
  most_recent = true
  owners      = ["099720109477"] # Canonical Account ID

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }
}

data "aws_ami" "windows" {
  count       = var.os_type == "Windows" ? 1 : 0
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["Windows_Server-2022-English-Full-Base-*"]
  }
}

locals {
  selected_ami_id = var.os_type == "Amazon2" ? data.aws_ami.amazon_linux[0].id : (
                    var.os_type == "RHEL" ? data.aws_ami.rhel[0].id : (
                    var.os_type == "Ubuntu" ? data.aws_ami.ubuntu[0].id : 
                    data.aws_ami.windows[0].id))
}

# -----------------------------------------------------------------------------
# NETWORKING
# -----------------------------------------------------------------------------

resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = {
    Name = "compliant-vpc"
  }
}

resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"
  map_public_ip_on_launch = true
  tags = {
    Name = "compliant-public-subnet"
  }
}

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
}

resource "aws_route_table" "rt" {
  vpc_id = aws_vpc.main.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }
}

resource "aws_route_table_association" "rta" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.rt.id
}

# -----------------------------------------------------------------------------
# EC2 INSTANCE CONFIGURATION (Enforcing Constraints)
# -----------------------------------------------------------------------------

resource "aws_instance" "compliant_vm" {
  ami                  = local.selected_ami_id
  instance_type        = var.instance_type
  subnet_id            = aws_subnet.public.id
  
  instance_initiated_shutdown_behavior = "terminate"

  credit_specification {
    cpu_credits = "standard"
  }

  root_block_device {
    volume_size           = var.root_volume_size_gb
    volume_type           = var.root_volume_type
    delete_on_termination = true
    encrypted             = true
  }

  tags = {
    Name                = "secure-constrained-instance"
    OperatingSystem     = var.os_type
    MaxVCPUs            = "2"
    MaxRAM              = "4GB"
    CPUAllocationPolicy = "Standard-Only"
  }
}